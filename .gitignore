# ---------------------------------------------------------------
# Shohona Tortlar — git tomonidan e'tiborsiz qoldiriladigan fayllar
# (backend + admin + miniapp uchun umumiy)
# ---------------------------------------------------------------

# --- Bog'liqliklar (dependencies) ---
node_modules/
.pnp
.pnp.js
jspm_packages/

# --- Build natijalari (Vite / Node) ---
dist/
dist-ssr/
build/
out/
*.local

# --- Maxfiy sozlamalar (TOKEN, DATABASE_URL va h.k.) ---
# Diqqat: .env hech qachon git'ga tushmasligi kerak!
.env
.env.*
!.env.example
*.pem
*.key

# --- Prisma ---
# Migratsiyalar (prisma/migrations/) saqlanadi — ularni o'chirmang.
# Faqat generatsiya qilingan client va lokal baza fayllari chiqarib tashlanadi.
prisma/generated/
**/prisma/generated/
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Loglar ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Kesh va vaqtinchalik fayllar ---
.cache/
.temp/
.tmp/
tmp/
temp/
.vite/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm
.node_repl_history

# --- Testlar / coverage ---
coverage/
*.lcov
.nyc_output/

# --- Muharrir (IDE) sozlamalari ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- Operatsion tizim fayllari ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.directory
.Trash-*

# --- Deploy / xosting ---
.vercel
.netlify
.firebase/
.serverless/

# --- Telegram / ngrok yordamchi fayllari ---
ngrok.exe
ngrok.yml
*.ngrok.log

# --- Yuklangan media (agar kelajakda lokal saqlansa) ---
uploads/
public/uploads/

# --- Claude Code lokal sozlamalari ---
.claude/settings.local.json
